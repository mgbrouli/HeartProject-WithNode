<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HEART | Cadastro</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="style.css">
</head>

<body class="bg-gray-950 w-screen h-screen">
    <container class="w-full h-screen flex items-center">

        <form class="w-full min-h-155 flex gap-2 flex-col justify-center  items-center" action="/api/auth" method="post">
            <fieldset
                class="bg-cyan-300 w-10/12 h-full flex flex-col justify-center items-center m-1 rounded-3xl border border-cyan-100 drop-shadow-amber-400">
                <legend class="w-2xs h-12 text-white text-4xl text-center align-sub font-bold">Cadastro</legend>

                <input
                    class="w-[70%] h-10 border-b border-b-zinc-200 outline-0 bg-cyan-300 text-lg m-1.5 focus:bg-white focus:rounded-tr-xl focus:rounded-bl-xl"
                    type="text" name="name" placeholder="Nome: " id="nome">


                <input
                    class="w-[70%] h-10 border-b border-b-zinc-200 mb-2.5 outline-0 bg-cyan-300 text-lg m-1.5 focus:bg-white focus:rounded-tr-xl focus:rounded-bl-xl"
                    type="email" name="email" placeholder="Email:" id="email">


                <select
                    class="w-[70%] h-11 border-b border-b-zinc-200 mb-2.5 outline-0 bg-cyan-300 text-lg m-1.5 focus:bg-white focus:rounded-tr-xl focus:rounded-bl-xl"
                    name="tipo_user" id="tipo">
                    <option value="none" selected>Escolha um tipo de conta</option>
                    <option value="pessoal">Pessoal</option>
                    <option value="empresa">Empresarial</option>
                </select>

                <input
                    class="w-[70%] h-11 border-b border-b-zinc-200 mb-2.5 outline-0 bg-cyan-300 text-lg m-1.5 focus:bg-white focus:rounded-tr-xl focus:rounded-bl-xl"
                    type="date" name="date" id="data">

                <input
                    class="w-[70%] h-10 border-b border-b-zinc-200 mb-2.5 outline-0 bg-cyan-300 text-lg m-1.5 focus:bg-white focus:rounded-tr-xl focus:rounded-bl-xl"
                    type="text" name="sexo" placeholder="Sexo">



                <input
                    class="w-[70%] h-10 border-b border-b-zinc-200 mb-2.5 outline-0 bg-cyan-300 text-lg m-1.5 focus:bg-white focus:rounded-tr-xl focus:rounded-bl-xl"
                    type="password" placeholder="Senha: " name="senha" id="pass">


                


                <button class="w-1/2 h-10 font-sans text-white text-shadow-black text-2xl outline-0 border-0 rounded-2xl m-2.5 bg-purple-500 cursor-pointer hover:bg-cyan-500 hover:text-zinc-500 shadow-emerald-800 shadow-2xl active:bg-pink-400 active:text-black" type="submit">Salvar</button>
                <button class="w-1/2 h-10 font-sans text-white text-shadow-black text-2xl outline-0 border-0 rounded-2xl m-2.5 bg-purple-500 cursor-pointer hover:bg-cyan-500 hover:text-zinc-500 shadow-emerald-800 shadow-2xl active:bg-pink-400 active:text-black" type="button" id="cancela">Cancelar</button>

            </fieldset>
        </form>
    </container>
    <script>
    
    </script>
</body>

</html>